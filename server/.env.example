# Server Port Configuration
PORT=5000

# Local Ollama Host Configuration (Default Ollama Server)
OLLAMA_HOST=http://localhost:11434

# Choose your local open-weight model (e.g. llama3.1, qwen2.5, mistral, deepseek-r1:8b)
OLLAMA_MODEL=llama3.1

# MongoDB Connection String (Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/devsprint
